# Copie este archivo como .env y pegue su llave. Nunca suba .env al repositorio.
# Llave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo principal del pipeline
GEMINI_MODEL=gemini-3.5-flash-lite

# 1 = responder solo desde la caché en disco (plan B sin internet)
ZAFRA_DEMO=0

# Bot de Telegram (opcional): token de @BotFather. Correr: cd backend && python bot_telegram.py
TELEGRAM_TOKEN=
